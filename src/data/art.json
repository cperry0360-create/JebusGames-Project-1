      "hero-cory-attack-4"
    ],
    "attackImpactFrame": 3,
    "roster": {
      "cory": {
        "base": "hero-cory",
        "powered": null,
        "walk": [
          "hero-cory-walk-1",
          "hero-cory-walk-2",
          "hero-cory-walk-3",
          "hero-cory-walk-4"
        ],
        "attack": [
