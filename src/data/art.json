  "hero": {
    "_note": "Frame lists for the hero animations. Anchors and displayHeight are per SET, not shared: walk is 557x704 and attack is 787x720, their feet sit at different fractions of their canvases, and their figures are 677 and 690 source px tall. One anchor for both would step the hero sideways on every swing. Frame 1 of each set is the registration reference; frames 2-4 move relative to it, which is the animation.",
    "idle": "hero-cory",
    "walk": [
      "hero-cory-walk-1",
      "hero-cory-walk-2",
      "hero-cory-walk-3",
